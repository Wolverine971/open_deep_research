# ================================
# Core LLM Providers (Required)
# ================================

# OpenAI - Used for GPT models and reasoning
OPENAI_API_KEY=sk-xxx

# Anthropic - Used for Claude models (primary writer)
ANTHROPIC_API_KEY=sk-xxx

# ================================
# Search Providers (At least one required)
# ================================

# Tavily - Fast web search API optimized for LLMs (Recommended)
TAVILY_API_KEY=xxx

# Perplexity - Advanced semantic search (Optional)
PERPLEXITY_API_KEY=xxx

# ================================
# Database (Required for blog updates)
# ================================

# Supabase - For fetching and storing 9takes blogs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ================================
# Optional Providers
# ================================

# Groq - For fast open-source models (Optional)
GROQ_API_KEY=xxx

# LangChain - For tracing and monitoring (Optional but recommended)
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=9takes-blog-updates

# ================================
# Application Settings
# ================================

# Default search method: tavily, perplexity, or mcp_puppeteer
DEFAULT_SEARCH_METHOD=tavily

# Default models
DEFAULT_PLANNER_MODEL=gpt-4
DEFAULT_WRITER_MODEL=claude-3-5-sonnet-latest

# Blog update settings
REQUIRE_HUMAN_APPROVAL=true
AUTO_SAVE_TO_SUPABASE=false
EXPORT_MARKDOWN_FILES=true